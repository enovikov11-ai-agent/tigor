{
  "$schema": "https://opencode.ai/config.json",

  "model": "openrouter/z-ai/glm-5.2",

  "permission": {
    "*": "ask",

    "edit": "allow",
    "task": "allow",
    "todowrite": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "read": "allow",

    "doom_loop": "deny"
  },

  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.2": {
          "name": "GLM 5.2",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "options": {
            "reasoning": {
              "effort": "high"
            }
          }
        }
      }
    }
  }
}