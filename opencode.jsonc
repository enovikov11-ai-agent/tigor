{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "tool_call": "ask",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff": "allow"
    },
    "task": "allow",
    "skill": "ask",
    "lsp": "ask",
    "todoread": "ask",
    "todowrite": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask",
    "external_directory": "ask",

    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "read": "allow",

    "doom_loop": "deny"
  },
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "local",
      "options": {
        "baseURL": "http://10.69.42.2:8000/v1"
      },
      "models": {
        "Qwen3.6-27B-FP8": {
          "name": "Qwen3.6-27B-FP8",
          "limit": {
            "context": 262144,
            "output": 16384  
          }
        }
      }
    }
  }
}
