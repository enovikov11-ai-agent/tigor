; fibonacci.asm  — prints F(0)…F(9)
; assemble: nasm -f elf64 fibonacci.asm
; link:     gcc -no-pie -o fibonacci fibonacci.o

    global  main
    extern  printf

;-------------------------------------------------------------------------
section .data
fmt     db      "F(%d) = %llu", 10, 0        ; "F(n) = value\n"

;-------------------------------------------------------------------------
section .text
; SysV-AMD64 calling convention:
;   RDI, RSI, RDX, RCX, R8, R9 = first 6 integer args (in that order)
;   RAX must be 0 before variadic printf

main:
        push    rbp
        mov     rbp, rsp
        sub     rsp, 32                      ; shadow space & 16-byte align

        mov     ecx, 10                      ; how many numbers to print
        xor     edi, edi                     ; n = 0      (EDI holds n)
        xor     r8,  r8                      ; F(n-2) = 0 (R8  holds f0)
        mov     r9,  1                       ; F(n-1) = 1 (R9  holds f1)

.loop:                                      ; ----- top of loop -----
        cmp     edi, ecx                     ; n >= count?
        jge     .done

        ; ---------------- print current Fibonacci ----------------
        mov     esi, edi                     ; 2nd arg  -> %d   (n)
        mov     rdx, r8                      ; 3rd arg  -> %llu (F(n))
        lea     rdi, [rel fmt]               ; 1st arg  -> fmt string
        xor     eax, eax                     ; printf needs RAX = 0
        call    printf

        ; ---------------- compute next Fibonacci ----------------
        mov     rax, r8                      ; rax = F(n)
        add     rax, r9                      ; rax = F(n)+F(n-1)
        mov     r8,  r9                      ; F(n-2) = old F(n-1)
        mov     r9,  rax                     ; F(n-1) = new value
        inc     edi                          ; n++

        jmp     .loop

.done:
        xor     eax, eax                     ; return 0
        leave
        ret