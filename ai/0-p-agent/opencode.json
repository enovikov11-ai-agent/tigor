{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "deny",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "skill": "deny",
    "lsp": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "external_directory": "deny",
    "doom_loop": "deny"
  },
  "instructions": ["./meta.md"],
  "provider": {
    "p-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "p-vllm",
      "options": {
        "baseURL": "http://p-vllm:8000/v1"
      },
      "models": {
        "qwen3-next-80b": {
          "name": "Qwen3-Next 80B",
          "limit": {
            "context": 65536,
            "output": 50000
          }
        }
      }
    },
    "p-llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "p-llama",
      "options": {
        "baseURL": "http://p-llama:8000/v1"
      },
      "models": {
        "minimax-m2.5": {
          "name": "MiniMax M2.5",
          "limit": {
            "context": 196608,
            "output": 170000
          }
        }
      }
    }
  }
}
